<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GestoClip.App</RootNamespace>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>GestoClip — Universal Gesture Clipboard</Product>
    <Company>Jovani Emmanuel Sanchez de Jesus</Company>
    <Authors>Jovani Emmanuel Sanchez de Jesus</Authors>
    <Copyright>Copyright (c) 2026 Jovani Emmanuel Sanchez de Jesus</Copyright>
    <Description>Portapapeles universal y transferencia por gestos en red local (Windows 11 y Android)</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GestoClip.Core\GestoClip.Core.csproj" />
    <ProjectReference Include="..\GestoClip.Vision\GestoClip.Vision.csproj" />
  </ItemGroup>
  <Target Name="RemoveOpenCvFfmpeg" BeforeTargets="GenerateSingleFileBundle;ComputeResolvedFilesToPublishList" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'opencv_videoio_ffmpeg4100_64.dll'" />
      <FilesToBundle Remove="@(FilesToBundle)" Condition="'%(Filename)%(Extension)' == 'opencv_videoio_ffmpeg4100_64.dll'" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'opencv_videoio_ffmpeg4100_64.dll'" />
    </ItemGroup>
  </Target>
</Project>
