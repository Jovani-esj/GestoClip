<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GestoClip.App</RootNamespace>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GestoClip.Core\GestoClip.Core.csproj" />
    <ProjectReference Include="..\GestoClip.Vision\GestoClip.Vision.csproj" />
  </ItemGroup>
  <Target Name="RemoveOpenCvFfmpeg" BeforeTargets="GenerateSingleFileBundle;ComputeResolvedFilesToPublishList" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'opencv_videoio_ffmpeg4100_64.dll'" />
      <FilesToBundle Remove="@(FilesToBundle)" Condition="'%(Filename)%(Extension)' == 'opencv_videoio_ffmpeg4100_64.dll'" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'opencv_videoio_ffmpeg4100_64.dll'" />
    </ItemGroup>
  </Target>
</Project>
